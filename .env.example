# Required: Google Maps JavaScript API key with Maps JavaScript API + Places API enabled.
# Restrict the key to your GitHub Pages domain + localhost in the Google Cloud console.
VITE_GOOGLE_MAPS_API_KEY=

# Optional: Map ID for Vector / styled maps (recommended for the dark theme).
# Create one at https://console.cloud.google.com/google/maps-apis/studio/maps
# If omitted the map falls back to inline JSON styling.
VITE_GOOGLE_MAPS_MAP_ID=

# Optional: NY Open Data Socrata app token (raises rate limits).
# Sign up free at https://data.ny.gov
VITE_NY_OPEN_DATA_APP_TOKEN=
